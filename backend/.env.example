# Local, free/open-source LLM runtime (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional local embedding model. If unavailable, RAG falls back to keyword search.
# Pull it with: ollama pull nomic-embed-text
OLLAMA_EMBED_MODEL=nomic-embed-text
USE_EMBEDDINGS=true

# SQLite database (MVP). Swap for Postgres in production.
DB_PATH=./data/sales_agent.db

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Allow the demo reset endpoint (clears leads/calls/appointments)
ALLOW_DEMO_RESET=true
