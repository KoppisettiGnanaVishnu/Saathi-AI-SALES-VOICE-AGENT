# LLM provider: "ollama" (local, default) or "openai_compatible" (Groq/OpenRouter/etc.)
LLM_PROVIDER=ollama
# For Groq: LLM_PROVIDER=openai_compatible, LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-20b
# gpt-oss-20b follows the strict JSON reply contract reliably; on failure the agent falls back to local Ollama.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Local Ollama (used for local chat and/or embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
USE_EMBEDDINGS=true

# SQLite database (MVP). Swap for Postgres in production.
DB_PATH=./data/sales_agent.db

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Allow the demo reset endpoint (clears leads/calls/appointments)
ALLOW_DEMO_RESET=true
